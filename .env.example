# Railway provides this automatically when PostgreSQL is attached.
DATABASE_URL="postgresql://postgres:password@localhost:5432/eltaulell?schema=public"

# Used later for authentication and protected routes.
AUTH_SECRET="replace-with-a-long-random-secret"
APP_BASE_URL="http://127.0.0.1:3000"
# 32 random bytes encoded as base64. Used to encrypt OAuth and connector tokens.
DATA_ENCRYPTION_KEY=""

# Enable the isolated public demo only when a separate demo entry should be visible.
# Local preview enables it automatically.
DEMO_ACCESS_ENABLED="0"

# Bootstrap access for the administrator/coordinator of one school.
# Store only a `scrypt-v1` hash in Railway; never commit the password.
CENTRE_ADMIN_EMAIL=""
CENTRE_ADMIN_PASSWORD_HASH=""
CENTRE_ADMIN_NAME=""
CENTRE_ADMIN_SCHOOL_NAME=""
CENTRE_ADMIN_SCHOOL_SLUG=""
CENTRE_ADMIN_EMAIL_DOMAIN=""

# Global SuperAdmin. Password must use the `scrypt-v1` format used by the app.
# TOTP secret is base32 and is required for production access.
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD_HASH=""
PLATFORM_ADMIN_NAME="Administració El Taulell"
PLATFORM_ADMIN_TOTP_SECRET=""
PLATFORM_ADMIN_ALLOWED_IPS=""

# Railway Bucket (S3-compatible object storage for private board files).
BUCKET=""
ACCESS_KEY_ID=""
SECRET_ACCESS_KEY=""
REGION="auto"
ENDPOINT="https://storage.railway.app"
AWS_S3_URL_STYLE="virtual"

# Google Workspace / Classroom. Configure these directly in Railway.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://eltaulell.aulaia.cat/api/auth/google/callback"
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/classroom.courses.readonly https://www.googleapis.com/auth/classroom.rosters.readonly https://www.googleapis.com/auth/classroom.coursework.me https://www.googleapis.com/auth/classroom.coursework.students https://www.googleapis.com/auth/calendar.events"

# Public base URL only. Never store temporary iEduca login links here.
MOODLE_BASE_URL="https://moodle.escolaindustrial.org/"
MOODLE_TOKEN=""
IEDUCA_BASE_URL=""
IEDUCA_API_TOKEN=""
IEDUCA_COURSES_PATH="/api/v1/courses"
IEDUCA_RESOURCES_PATH="/api/v1/resources"
IEDUCA_ACTIVITIES_PATH="/api/v1/activities"

# Tutor IA. When the key is empty, the endpoint returns a configuration error
# without falling back to simulated answers.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-sol"
AI_DAILY_QUESTION_LIMIT="40"
AI_RETENTION_DAYS="90"

# Transactional email / SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="0"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="El Taulell <no-reply@aulaia.cat>"
EMAIL_HTTP_ENDPOINT=""
EMAIL_HTTP_TOKEN=""

# Protected operational jobs and optional observability exporter.
CRON_SECRET=""
BACKUP_ENCRYPTION_KEY=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
