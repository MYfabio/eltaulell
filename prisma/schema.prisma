generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  COORDINATOR
  TUTOR
  DELEGATE
  STUDENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SchoolPlan {
  PILOT
  STANDARD
}

enum GroupMemberRole {
  TUTOR
  DELEGATE
  STUDENT
}

enum PostItStatus {
  OPEN
  ARCHIVED
}

enum PostItType {
  NOTICE
  TASK
  ACTIVITY
  MATERIAL
  QUESTION
}

enum BoardPollStatus {
  PENDING_APPROVAL
  OPEN
  CLOSED
  PUBLISHED
}

enum IntegrationProvider {
  GOOGLE_CLASSROOM
  GOOGLE_CALENDAR
  MOODLE
  IEDUCA
}

enum IntegrationStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
}

enum IdentityProvider {
  GOOGLE
}

enum DemoRequestStatus {
  PENDING
  INVITED
  CLOSED
}

enum LearningTaskStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  GRADED
}

enum AiRiskLevel {
  NONE
  CONCERN
  URGENT
}

enum AnonymousQueryStatus {
  OPEN
  ASSIGNED
  CLOSED
}

enum AnonymousMessageAuthor {
  STUDENT_ANONYMOUS
  TUTOR
  COORDINATOR
  SYSTEM
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCESS
  ERROR
}

enum SyncDirection {
  PULL
  PUSH
  BIDIRECTIONAL
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model School {
  id                String                  @id @default(cuid())
  name              String
  slug              String                  @unique
  emailDomain       String?
  moodleBaseUrl     String?
  active            Boolean                 @default(true)
  plan              SchoolPlan              @default(PILOT)
  maxUsers          Int                     @default(500)
  maxGroups         Int                     @default(30)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  memberships       SchoolMembership[]
  groups            Group[]
  integrations      IntegrationConnection[]
  invitations       Invitation[]
  groupInvites      GroupInvite[]
  calendarEvents    CalendarEvent[]
  auditLogs         AuditLog[]
  platformAuditLogs PlatformAuditLog[]
  learningTasks     LearningTask[]
  aiUsageEvents     AiUsageEvent[]
  anonymousQueries  AnonymousQuery[]
  syncJobs          IntegrationSyncJob[]
  errorLogs         SystemErrorLog[]
  retentionPolicy   DataRetentionPolicy?
}

model User {
  id                  String                  @id @default(cuid())
  name                String
  email               String                  @unique
  image               String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  memberships         SchoolMembership[]
  posts               PostIt[]
  pollsCreated        BoardPoll[]             @relation("PollCreatedBy")
  pollsValidated      BoardPoll[]             @relation("PollValidatedBy")
  pollVotes           BoardPollVote[]
  boardAttachments    BoardAttachment[]
  oauthAccounts       OAuthAccount[]
  sessions            Session[]
  acceptedInvites     Invitation[]            @relation("AcceptedInvitation")
  groupInvitesCreated GroupInvite[]           @relation("GroupInviteCreatedBy")
  auditLogs           AuditLog[]
  platformAdmin       PlatformAdmin?
  passwordCredential  PasswordCredential?
  passwordResetTokens PasswordResetToken[]
  queryReplies        AnonymousQueryMessage[]
  emailDeliveries     EmailDelivery[]
}

model PasswordCredential {
  id             String    @id @default(cuid())
  userId         String    @unique
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  passwordSetAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
}

model PlatformAdmin {
  id          String             @id @default(cuid())
  userId      String             @unique
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs   PlatformAuditLog[]
  mfaEnabled  Boolean            @default(true)
  lastLoginAt DateTime?
}

model PlatformAuditLog {
  id              String         @id @default(cuid())
  platformAdminId String?
  schoolId        String?
  action          String
  entityType      String
  entityId        String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  platformAdmin   PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)
  school          School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([platformAdminId])
  @@index([schoolId, createdAt])
}

model DemoRequest {
  id                  String            @id @default(cuid())
  name                String
  email               String
  schoolName          String
  requestedRole       MembershipRole    @default(STUDENT)
  message             String?
  privacyAcceptedAt   DateTime
  status              DemoRequestStatus @default(PENDING)
  invitationExpiresAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model SchoolMembership {
  id               String            @id @default(cuid())
  schoolId         String
  userId           String
  role             MembershipRole
  status           MembershipStatus  @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupMemberships GroupMembership[]
  sessions         Session[]
  learningTasks    LearningTask[]
  aiUsageEvents    AiUsageEvent[]

  @@unique([schoolId, userId])
  @@index([schoolId, role])
  @@index([userId, status])
}

model Group {
  id               String            @id @default(cuid())
  schoolId         String
  name             String
  stage            String
  section          String?
  academicYear     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  members          GroupMembership[]
  board            Board?
  calendarEvents   CalendarEvent[]
  externalCourses  ExternalCourse[]
  invites          GroupInvite[]
  learningTasks    LearningTask[]
  aiUsageEvents    AiUsageEvent[]
  anonymousQueries AnonymousQuery[]

  @@unique([schoolId, academicYear, name])
  @@index([schoolId])
}

model GroupMembership {
  id                 String           @id @default(cuid())
  groupId            String
  schoolMembershipId String
  role               GroupMemberRole
  createdAt          DateTime         @default(now())
  group              Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  schoolMembership   SchoolMembership @relation(fields: [schoolMembershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, schoolMembershipId])
  @@index([schoolMembershipId])
}

model Board {
  id          String            @id @default(cuid())
  groupId     String            @unique
  title       String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  posts       PostIt[]
  polls       BoardPoll[]
  attachments BoardAttachment[]
}

model PostIt {
  id        String       @id @default(cuid())
  title     String
  message   String
  type      PostItType   @default(NOTICE)
  status    PostItStatus @default(OPEN)
  anonymous Boolean      @default(false)
  boardId   String
  authorId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([boardId, status, createdAt])
  @@index([authorId])
}

model BoardPoll {
  id            String            @id @default(cuid())
  boardId       String
  question      String
  anonymous     Boolean           @default(true)
  status        BoardPollStatus   @default(PENDING_APPROVAL)
  closesAt      DateTime?
  createdById   String?
  createdByRole String
  validatedById String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  board         Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("PollCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  validatedBy   User?             @relation("PollValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  options       BoardPollOption[]
  votes         BoardPollVote[]

  @@index([boardId, status, createdAt])
  @@index([createdById])
  @@index([validatedById])
}

model BoardPollOption {
  id       String          @id @default(cuid())
  pollId   String
  label    String
  position Int
  poll     BoardPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    BoardPollVote[]

  @@unique([pollId, position])
  @@index([pollId])
}

model BoardPollVote {
  id        String          @id @default(cuid())
  pollId    String
  optionId  String
  voterKey  String
  voterId   String?
  createdAt DateTime        @default(now())
  poll      BoardPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    BoardPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voter     User?           @relation(fields: [voterId], references: [id], onDelete: SetNull)

  @@unique([pollId, voterKey])
  @@index([optionId])
  @@index([voterId])
}

model BoardAttachment {
  id              String   @id @default(cuid())
  boardId         String
  fileName        String
  mimeType        String
  sizeBytes       Int
  caption         String?
  storageKey      String?  @unique
  storageProvider String   @default("POSTGRESQL")
  content         Bytes?
  uploadedById    String?
  uploadedByRole  String
  createdAt       DateTime @default(now())
  board           Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  uploadedBy      User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([uploadedById])
}

model CalendarEvent {
  id          String               @id @default(cuid())
  schoolId    String
  groupId     String?
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  provider    IntegrationProvider?
  externalId  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group       Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([schoolId, startsAt])
  @@index([groupId, startsAt])
}

model LearningTask {
  id                   String               @id @default(cuid())
  schoolId             String
  groupId              String
  studentMembershipId  String
  externalCourseId     String?
  provider             IntegrationProvider?
  externalId           String?
  externalSubmissionId String?
  title                String
  description          String?
  subject              String
  status               LearningTaskStatus   @default(PENDING)
  dueAt                DateTime?
  openedAt             DateTime?
  deliveredAt          DateTime?
  gradedAt             DateTime?
  grade                Float?
  maximumGrade         Float?
  teacherFeedback      String?
  resourceUrl          String?
  lastSyncedAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group                Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentMembership    SchoolMembership     @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  externalCourse       ExternalCourse?      @relation(fields: [externalCourseId], references: [id], onDelete: SetNull)

  @@unique([studentMembershipId, provider, externalId])
  @@index([schoolId, groupId, status])
  @@index([studentMembershipId, dueAt])
  @@index([provider, externalSubmissionId])
}

model AiUsageEvent {
  id                  String           @id @default(cuid())
  schoolId            String
  groupId             String
  studentMembershipId String
  sessionKeyHash      String
  subject             String?
  taskId              String?
  questionCount       Int              @default(1)
  durationSeconds     Int              @default(0)
  repeatedHelpSignal  Boolean          @default(false)
  riskLevel           AiRiskLevel      @default(NONE)
  createdAt           DateTime         @default(now())
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group               Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentMembership   SchoolMembership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, groupId, createdAt])
  @@index([studentMembershipId, createdAt])
  @@index([sessionKeyHash, createdAt])
}

model AnonymousQuery {
  id              String                  @id @default(cuid())
  schoolId        String
  groupId         String
  publicReference String                  @unique
  accessTokenHash String                  @unique
  subject         String
  status          AnonymousQueryStatus    @default(OPEN)
  assignedRole    MembershipRole?
  closedAt        DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  school          School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group           Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages        AnonymousQueryMessage[]

  @@index([schoolId, status, createdAt])
  @@index([groupId, status, createdAt])
}

model AnonymousQueryMessage {
  id          String                 @id @default(cuid())
  queryId     String
  authorKind  AnonymousMessageAuthor
  responderId String?
  body        String
  createdAt   DateTime               @default(now())
  query       AnonymousQuery         @relation(fields: [queryId], references: [id], onDelete: Cascade)
  responder   User?                  @relation(fields: [responderId], references: [id], onDelete: SetNull)

  @@index([queryId, createdAt])
  @@index([responderId])
}

model IntegrationConnection {
  id                      String               @id @default(cuid())
  schoolId                String
  provider                IntegrationProvider
  status                  IntegrationStatus    @default(DISCONNECTED)
  baseUrl                 String?
  externalTenantId        String?
  settings                Json?
  lastSyncedAt            DateTime?
  accessTokenCiphertext   String?
  refreshTokenCiphertext  String?
  tokenExpiresAt          DateTime?
  webhookSecretCiphertext String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  school                  School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  syncJobs                IntegrationSyncJob[]

  @@unique([schoolId, provider])
  @@index([status])
}

model ExternalCourse {
  id            String              @id @default(cuid())
  groupId       String
  provider      IntegrationProvider
  externalId    String
  name          String
  url           String?
  lastSyncedAt  DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  group         Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  learningTasks LearningTask[]

  @@unique([provider, externalId])
  @@index([groupId, provider])
}

model IntegrationSyncJob {
  id             String                @id @default(cuid())
  schoolId       String
  connectionId   String
  provider       IntegrationProvider
  direction      SyncDirection         @default(PULL)
  status         SyncJobStatus         @default(PENDING)
  cursor         String?
  processedCount Int                   @default(0)
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  school         School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([schoolId, provider, status])
  @@index([connectionId, createdAt])
}

model OAuthAccount {
  id                     String           @id @default(cuid())
  userId                 String
  provider               IdentityProvider
  providerAccountId      String
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  accessTokenExpiresAt   DateTime?
  scopes                 String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id                 String            @id @default(cuid())
  userId             String
  schoolMembershipId String?
  tokenHash          String            @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  lastSeenAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolMembership   SchoolMembership? @relation(fields: [schoolMembershipId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([schoolMembershipId, expiresAt])
  @@index([revokedAt, expiresAt])
}

model Invitation {
  id           String         @id @default(cuid())
  schoolId     String
  email        String
  role         MembershipRole
  tokenHash    String         @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime       @default(now())
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  acceptedBy   User?          @relation("AcceptedInvitation", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([schoolId, email])
}

model GroupInvite {
  id          String   @id @default(cuid())
  schoolId    String
  groupId     String
  createdById String?
  codeHash    String   @unique
  expiresAt   DateTime
  maxUses     Int      @default(30)
  useCount    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("GroupInviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([groupId, active, expiresAt])
  @@index([createdById])
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([actorId])
}

model EmailDelivery {
  id           String              @id @default(cuid())
  userId       String?
  recipient    String
  template     String
  subject      String
  status       EmailDeliveryStatus @default(PENDING)
  providerId   String?
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([recipient, createdAt])
  @@index([status, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model DataRetentionPolicy {
  id                   String   @id @default(cuid())
  schoolId             String   @unique
  taskRetentionDays    Int      @default(730)
  aiUsageRetentionDays Int      @default(90)
  queryRetentionDays   Int      @default(365)
  auditRetentionDays   Int      @default(730)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  school               School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SystemErrorLog {
  id        String   @id @default(cuid())
  schoolId  String?
  requestId String?
  source    String
  code      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([code, createdAt])
}
